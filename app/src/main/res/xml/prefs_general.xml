<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/prefs_general_category_appearance">

        <!-- SettingsKeys.GENERAL_LANGUAGE -->
        <ListPreference
            app:key="sanad.general.language"
            app:title="@string/prefs_general_language_title"
            app:entries="@array/language_entries"
            app:entryValues="@array/language_values"
            app:useSimpleSummaryProvider="true" />

        <!-- SettingsKeys.GENERAL_THEME -->
        <ListPreference
            app:key="sanad.general.theme"
            app:title="@string/prefs_general_theme_title"
            app:entries="@array/theme_entries"
            app:entryValues="@array/theme_values"
            app:useSimpleSummaryProvider="true" />

        <!-- SettingsKeys.GENERAL_DYNAMIC_COLOR — hidden by fragment on API < 31 -->
        <SwitchPreferenceCompat
            app:key="sanad.general.dynamic_color"
            app:title="@string/prefs_general_dynamic_color_title"
            app:summary="@string/prefs_general_dynamic_color_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/prefs_general_category_behavior">

        <!-- SettingsKeys.GENERAL_ANIMATIONS -->
        <SwitchPreferenceCompat
            app:key="sanad.general.animations"
            app:title="@string/prefs_general_animations_title"
            app:summary="@string/prefs_general_animations_summary" />

        <!-- SettingsKeys.GENERAL_HAPTICS -->
        <SwitchPreferenceCompat
            app:key="sanad.general.haptics"
            app:title="@string/prefs_general_haptics_title"
            app:summary="@string/prefs_general_haptics_summary" />

        <!-- SettingsKeys.GENERAL_SHOW_ONBOARDING -->
        <SwitchPreferenceCompat
            app:key="sanad.general.show_onboarding"
            app:title="@string/prefs_general_onboarding_title"
            app:summary="@string/prefs_general_onboarding_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/prefs_general_category_data">

        <Preference
            app:key="pref_general_reset_first_launch"
            app:title="@string/prefs_general_reset_first_launch_title"
            app:summary="@string/prefs_general_reset_first_launch_summary" />
    </PreferenceCategory>

</PreferenceScreen>