<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/prefs_sharing_category_general">

        <SwitchPreferenceCompat
            app:key="sanad.share.enabled"
            app:title="@string/prefs_sharing_enabled_title"
            app:summary="@string/prefs_sharing_enabled_summary" />

        <ListPreference
            app:key="sanad.share.default_action"
            app:title="@string/prefs_sharing_default_action_title"
            app:entries="@array/sharing_action_entries"
            app:entryValues="@array/sharing_action_values"
            app:useSimpleSummaryProvider="true"
            app:dependency="sanad.share.enabled" />

        <SwitchPreferenceCompat
            app:key="sanad.share.include_watermark"
            app:title="@string/prefs_sharing_watermark_title"
            app:summary="@string/prefs_sharing_watermark_summary"
            app:dependency="sanad.share.enabled" />
    </PreferenceCategory>

</PreferenceScreen>