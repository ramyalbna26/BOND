<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/prefs_controls_category_image">

        <ListPreference
            app:key="sanad.controls.image_quality"
            app:title="@string/prefs_controls_image_quality_title"
            app:entries="@array/image_quality_entries"
            app:entryValues="@array/image_quality_values"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="sanad.controls.image_max_dimension"
            app:title="@string/prefs_controls_image_max_dim_title"
            app:entries="@array/image_max_dimension_entries"
            app:entryValues="@array/image_max_dimension_values"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="sanad.controls.image_format"
            app:title="@string/prefs_controls_image_format_title"
            app:entries="@array/image_format_entries"
            app:entryValues="@array/image_format_values"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="sanad.controls.image_auto_compress"
            app:title="@string/prefs_controls_image_compress_title"
            app:summary="@string/prefs_controls_image_compress_summary" />

        <SwitchPreferenceCompat
            app:key="sanad.controls.image_alt_text_required"
            app:title="@string/prefs_controls_alt_text_title"
            app:summary="@string/prefs_controls_alt_text_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/prefs_controls_category_text">

        <ListPreference
            app:key="sanad.controls.text_default_font"
            app:title="@string/prefs_controls_text_font_title"
            app:entries="@array/font_arabic_entries"
            app:entryValues="@array/font_arabic_values"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="sanad.controls.text_default_size"
            app:title="@string/prefs_controls_text_size_title"
            app:entries="@array/font_size_entries"
            app:entryValues="@array/font_size_values"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="sanad.controls.text_default_spacing"
            app:title="@string/prefs_controls_text_spacing_title"
            app:entries="@array/text_spacing_entries"
            app:entryValues="@array/text_spacing_values"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="sanad.controls.text_default_alignment"
            app:title="@string/prefs_controls_text_align_title"
            app:entries="@array/text_alignment_entries"
            app:entryValues="@array/text_alignment_values"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/prefs_controls_category_behavior">

        <SwitchPreferenceCompat
            app:key="sanad.controls.text_show_word_count"
            app:title="@string/prefs_controls_word_count_title"
            app:summary="@string/prefs_controls_word_count_summary" />

        <SwitchPreferenceCompat
            app:key="sanad.controls.text_apply_default_style"
            app:title="@string/prefs_controls_apply_default_title"
            app:summary="@string/prefs_controls_apply_default_summary" />
    </PreferenceCategory>

</PreferenceScreen>